{
  "name": "dsh-novels",
  "version": "0.1.5",
  "description": "Read .txt novels inside DeepSeek Harness: import a file, get chapters split automatically, and read it in a panel next to the conversation.",
  "license": "MIT",
  "author": "darlingsakurua",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "novel",
    "txt",
    "reader"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darlingsakurua/dsh-novels.git"
  },
  "homepage": "https://github.com/darlingsakurua/dsh-novels#readme",
  "bugs": {
    "url": "https://github.com/darlingsakurua/dsh-novels/issues"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon-180.png",
    "docs",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
